import { ExternalLink, Star, MapPin, Utensils, CheckCircle2, AlertCircle } from 'lucide-react'
import { RESTAURANTS } from '../data/restaurants'
import clsx from 'clsx'

const CATEGORY_COLORS = {
  imperdible: 'bg-coral-400/10 text-coral-600 dark:text-coral-400 border-coral-200 dark:border-coral-700',
  experiencia: 'bg-jungle-50 dark:bg-jungle-700/20 text-jungle-700 dark:text-celadon-400 border-jungle-200 dark:border-jungle-700',
  local: 'bg-sand-100 dark:bg-sand-700/20 text-sand-700 dark:text-sand-300 border-sand-200 dark:border-sand-700',
  clasico: 'bg-ocean-300/10 text-ocean-500 border-ocean-300/30',
  vistas: 'bg-celadon-50 dark:bg-celadon-700/20 text-celadon-700 dark:text-celadon-400 border-celadon-200 dark:border-celadon-700',
}

const CATEGORY_LABELS = {
  imperdible: '🔥 Imperdible',
  experiencia: '✨ Experiencia',
  local: '🌮 Local',
  clasico: '⭐ Clásico',
  vistas: '🌅 Vistas',
}

function RestaurantCard({ r }) {
  return (
    <div className="card p-5 hover:shadow-float transition-shadow duration-200 animate-fade-up space-y-3">
      <div className="flex items-start justify-between gap-2">
        <div className="flex-1">
          <div className="flex items-center gap-2 flex-wrap mb-1">
            <h3 className="font-display font-bold text-bark-900 dark:text-white text-lg">{r.name}</h3>
            <span className={clsx('badge border text-[10px]', CATEGORY_COLORS[r.category])}>
              {CATEGORY_LABELS[r.category]}
            </span>
          </div>
          <p className="text-xs text-bark-500 dark:text-bark-400 flex items-center gap-1">
            <MapPin size={11} />{r.city} · {r.cuisine}
          </p>
        </div>
        <div className="text-right shrink-0">
          <div className="flex items-center gap-1 justify-end">
            <Star size={13} className="text-yellow-400 fill-yellow-400" />
            <span className="font-bold text-bark-800 dark:text-bark-200">{r.rating}</span>
          </div>
          <div className="text-xs text-bark-500 dark:text-bark-400">{r.reviews} reviews</div>
          <div className="text-sm font-bold text-celadon-600 dark:text-celadon-400 mt-1">{r.priceRange} · ~${r.avgCost}</div>
        </div>
      </div>

      <p className="text-sm text-bark-600 dark:text-bark-400">{r.description}</p>

      {/* Must order */}
      <div>
        <div className="text-[10px] font-semibold text-bark-400 dark:text-bark-500 uppercase tracking-wider mb-1.5">Pedí sí o sí</div>
        <div className="flex flex-wrap gap-1.5">
          {r.mustOrder.map((item, i) => (
            <span key={i} className="text-xs bg-bark-50 dark:bg-bark-700/30 text-bark-700 dark:text-bark-300 px-2.5 py-1 rounded-full">
              {item}
            </span>
          ))}
        </div>
      </div>

      {/* Tip */}
      <div className="flex gap-2 bg-sand-100/70 dark:bg-sand-700/10 rounded-xl px-3 py-2.5">
        <AlertCircle size={14} className="text-sand-600 dark:text-sand-400 shrink-0 mt-0.5" />
        <p className="text-xs text-sand-700 dark:text-sand-300">{r.tip}</p>
      </div>

      {/* Status row */}
      <div className="flex items-center justify-between">
        <div className="flex items-center gap-1 text-xs text-bark-500 dark:text-bark-400">
          {r.reservationRequired
            ? <><CheckCircle2 size={12} className="text-coral-400" /> Reserva necesaria</>
            : <><CheckCircle2 size={12} className="text-celadon-500" /> Sin reserva</>
          }
        </div>
        <a href={r.mapsUrl} target="_blank" rel="noreferrer"
          className="flex items-center gap-1 text-xs font-medium text-celadon-600 dark:text-celadon-400 hover:underline">
          <ExternalLink size={11} /> Ver en Maps
        </a>
      </div>
    </div>
  )
}

export default function RestaurantsPage() {
  return (
    <div className="space-y-5 max-w-6xl mx-auto animate-fade-in">
      <div>
        <h1 className="section-title">Restaurantes 🍽️</h1>
        <p className="text-sm text-bark-500 dark:text-bark-400 mt-1">Los mejores de la ruta — de soda local a cocina de autor</p>
      </div>

      <div className="grid md:grid-cols-2 gap-4">
        {RESTAURANTS.map(r => <RestaurantCard key={r.id} r={r} />)}
      </div>
    </div>
  )
}
