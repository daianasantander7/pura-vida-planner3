import { useState } from 'react'
import { format, parseISO } from 'date-fns'
import { es } from 'date-fns/locale'
import { MapPin, Clock, Utensils, Lightbulb, DollarSign, ChevronDown, ChevronUp, Car, Hotel } from 'lucide-react'
import { ITINERARY } from '../data/itinerary'
import clsx from 'clsx'

function DayCard({ day }) {
  const [open, setOpen] = useState(false)
  const date = parseISO(day.date)

  return (
    <div className={clsx(
      'card overflow-hidden transition-all duration-300 animate-fade-up',
      open && 'shadow-float'
    )}>
      {/* Header */}
      <button
        onClick={() => setOpen(o => !o)}
        className="w-full text-left"
      >
        <div className="p-4 md:p-5">
          <div className="flex items-start gap-4">
            {/* Day number */}
            <div className="shrink-0 w-12 h-12 rounded-2xl bg-gradient-to-br from-jungle-500 to-celadon-500 flex flex-col items-center justify-center">
              <span className="text-[10px] text-celadon-200 font-medium uppercase">Día</span>
              <span className="text-white font-display font-bold text-lg leading-none">{day.day}</span>
            </div>

            <div className="flex-1 min-w-0">
              <div className="flex items-center gap-2 flex-wrap">
                <h3 className="font-display font-bold text-bark-900 dark:text-white text-lg">
                  {day.emoji} {day.title}
                </h3>
              </div>
              <div className="flex items-center gap-3 mt-1 text-xs text-bark-500 dark:text-bark-400 flex-wrap">
                <span className="flex items-center gap-1"><MapPin size={11} />{day.region}</span>
                <span>{format(date, 'EEEE d MMM', { locale: es })}</span>
                <span className="flex items-center gap-1"><Hotel size={11} />{day.accommodation || 'Vuelo de vuelta'}</span>
              </div>
              <p className="text-sm text-bark-600 dark:text-bark-400 mt-1.5 line-clamp-1">{day.description}</p>
            </div>

            <div className="shrink-0 flex flex-col items-end gap-1">
              <span className="text-sm font-bold text-bark-800 dark:text-bark-200">${day.budget.total}</span>
              <span className="text-[10px] text-bark-400">est./persona</span>
              {open ? <ChevronUp size={16} className="text-bark-400 mt-1" /> : <ChevronDown size={16} className="text-bark-400 mt-1" />}
            </div>
          </div>
        </div>
      </button>

      {/* Expanded content */}
      {open && (
        <div className="border-t border-bark-100 dark:border-bark-700">
          <div className="p-4 md:p-5 grid md:grid-cols-2 gap-6">

            {/* Activities */}
            <div>
              <h4 className="text-xs font-semibold text-bark-500 dark:text-bark-400 uppercase tracking-wider mb-3 flex items-center gap-1.5">
                <Clock size={12} /> Actividades del día
              </h4>
              <div className="space-y-2">
                {day.activities.map((act, i) => (
                  <div key={i} className="flex gap-3 items-start">
                    <div className="text-xs font-mono text-bark-400 dark:text-bark-500 w-12 pt-0.5 shrink-0">{act.time}</div>
                    <div className="flex-1">
                      <div className="text-sm font-medium text-bark-800 dark:text-bark-200">{act.name}</div>
                      {act.note && <div className="text-xs text-bark-500 dark:text-bark-400 mt-0.5 italic">{act.note}</div>}
                    </div>
                    {act.cost > 0 && (
                      <div className="text-xs font-semibold text-celadon-600 dark:text-celadon-400 shrink-0">${act.cost}</div>
                    )}
                    {act.cost === 0 && (
                      <div className="text-xs text-bark-400 dark:text-bark-500 shrink-0">gratis</div>
                    )}
                  </div>
                ))}
              </div>
            </div>

            <div className="space-y-4">
              {/* Meals */}
              <div>
                <h4 className="text-xs font-semibold text-bark-500 dark:text-bark-400 uppercase tracking-wider mb-3 flex items-center gap-1.5">
                  <Utensils size={12} /> Comidas
                </h4>
                <div className="space-y-1.5">
                  {Object.entries(day.meals).filter(([, v]) => v).map(([meal, place]) => (
                    <div key={meal} className="flex gap-2 items-start text-sm">
                      <span className="text-xs text-bark-400 dark:text-bark-500 capitalize w-20 shrink-0 pt-0.5">{
                        meal === 'breakfast' ? '🌅 Desayuno' : meal === 'lunch' ? '☀️ Almuerzo' : '🌙 Cena'
                      }</span>
                      <span className="text-bark-700 dark:text-bark-300">{place}</span>
                    </div>
                  ))}
                </div>
              </div>

              {/* Tips */}
              {day.tips && (
                <div>
                  <h4 className="text-xs font-semibold text-bark-500 dark:text-bark-400 uppercase tracking-wider mb-3 flex items-center gap-1.5">
                    <Lightbulb size={12} /> Tips del día
                  </h4>
                  <div className="space-y-1.5">
                    {day.tips.map((tip, i) => (
                      <div key={i} className="flex gap-2 text-xs text-bark-600 dark:text-bark-400">
                        <span className="text-sand-500 shrink-0">→</span>
                        <span>{tip}</span>
                      </div>
                    ))}
                  </div>
                </div>
              )}

              {/* Budget breakdown */}
              <div>
                <h4 className="text-xs font-semibold text-bark-500 dark:text-bark-400 uppercase tracking-wider mb-3 flex items-center gap-1.5">
                  <DollarSign size={12} /> Desglose estimado
                </h4>
                <div className="grid grid-cols-2 gap-2">
                  {Object.entries(day.budget).filter(([k]) => k !== 'total').map(([k, v]) => (
                    <div key={k} className="flex justify-between text-xs bg-bark-50 dark:bg-bark-700/30 rounded-lg px-2.5 py-1.5">
                      <span className="text-bark-500 dark:text-bark-400 capitalize">{
                        k === 'accommodation' ? '🏨 Alojam.' : k === 'food' ? '🍽️ Comida' : k === 'activities' ? '🎯 Activid.' : '🚗 Transport.'
                      }</span>
                      <span className="font-semibold text-bark-800 dark:text-bark-200">${v}</span>
                    </div>
                  ))}
                </div>
                <div className="flex justify-between items-center mt-2 px-2.5 py-1.5 bg-celadon-50 dark:bg-celadon-700/20 rounded-lg">
                  <span className="text-xs font-bold text-celadon-700 dark:text-celadon-400">Total día</span>
                  <span className="text-sm font-bold text-celadon-700 dark:text-celadon-400">${day.budget.total}</span>
                </div>
              </div>

              {/* Drive to next */}
              {day.drivingToNext && day.drivingToNext.km > 0 && (
                <div className="flex items-center gap-2 bg-sand-100 dark:bg-sand-700/20 rounded-xl px-3 py-2.5 text-xs">
                  <Car size={13} className="text-sand-600 dark:text-sand-400 shrink-0" />
                  <span className="text-sand-700 dark:text-sand-300 font-medium">
                    Próximo: {day.drivingToNext.destination} · {day.drivingToNext.km}km · {day.drivingToNext.hours}h
                  </span>
                </div>
              )}
            </div>
          </div>
        </div>
      )}
    </div>
  )
}

export default function ItineraryPage() {
  const totalBudget = ITINERARY.reduce((s, d) => s + d.budget.total, 0)

  return (
    <div className="space-y-4 max-w-4xl mx-auto animate-fade-in">
      <div className="flex items-start justify-between flex-wrap gap-3">
        <div>
          <h1 className="section-title">Itinerario 📅</h1>
          <p className="text-sm text-bark-500 dark:text-bark-400 mt-1">15 días · 16–31 de enero 2026 · Dai, Juli, Gonza</p>
        </div>
        <div className="card px-4 py-3 text-right">
          <div className="text-xs text-bark-500 dark:text-bark-400">Total estimado</div>
          <div className="font-display font-bold text-xl text-bark-900 dark:text-white">${totalBudget.toLocaleString()}</div>
          <div className="text-xs text-celadon-600 dark:text-celadon-400">${Math.round(totalBudget / 3)} / persona</div>
        </div>
      </div>

      <div className="space-y-3">
        {ITINERARY.map((day, i) => (
          <div key={day.day} className={`stagger-${Math.min(i + 1, 6)}`}>
            <DayCard day={day} />
          </div>
        ))}
      </div>
    </div>
  )
}
